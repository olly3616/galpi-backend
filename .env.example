# ─────────────────────────────────────────────────────────────
# 갈피 백엔드 - 필요한 비밀/설정값 목록 (값 없는 예시 파일)
#
# 이 파일은 "이 앱을 실행하려면 어떤 값이 필요한지" 알려주는 문서입니다.
# 실제 값은 여기 적지 말고, 각자 OS 사용자 환경변수로 등록하세요.
# (이 파일 자체는 값이 없으므로 git에 커밋해도 안전합니다.)
#
# 실제 값이 담긴 .env / application-local.yml 등은 .gitignore로 제외됩니다.
# ─────────────────────────────────────────────────────────────

# MySQL 접속 비밀번호 (application.yaml의 spring.datasource.password)
DB_PASSWORD=

# JWT 서명 시크릿. 최소 32바이트(권장 64바이트) 랜덤 문자열.
# 미설정 시 애플리케이션이 기동되지 않습니다.
JWT_SECRET=

# 카카오 REST API 키 (도서 검색 기능). Kakao Developers에서 발급.
# 미설정 시 도서 검색 API만 실패하고, 앱 기동 자체는 됩니다.
KAKAO_REST_API_KEY=

# ─────────────────────────────────────────────────────────────
# [Windows] 사용자 환경변수 등록 예시 (본인 PowerShell 창에서 실행):
#   [Environment]::SetEnvironmentVariable('DB_PASSWORD', '값', 'User')
#   [Environment]::SetEnvironmentVariable('JWT_SECRET', '값', 'User')
#   [Environment]::SetEnvironmentVariable('KAKAO_REST_API_KEY', '값', 'User')
# 등록 후에는 IntelliJ를 완전히 종료했다가 다시 실행해야 값이 반영됩니다.
# ─────────────────────────────────────────────────────────────
